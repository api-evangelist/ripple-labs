{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses Fees API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Fees",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get fees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/config/fees",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Number of pages returned. Returns one page of results when set to `0`."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of objects returned per page."
              }
            ]
          },
          "docs": "Gets a list of fees."
        },
        {
          "info": {
            "name": "Create fee",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/config/fees",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a fee."
        },
        {
          "info": {
            "name": "Get fee by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/config/fees/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Provide the `feeId` of the fee you want to retrieve."
              }
            ]
          },
          "docs": "Gets a fee by ID."
        },
        {
          "info": {
            "name": "Update fee",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sandbox.palisade.co/config/fees/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Provide the `feeId` of the fee you want to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing fee."
        },
        {
          "info": {
            "name": "Delete fee",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sandbox.palisade.co/config/fees/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Provide the `feeId` of the fee you want to delete."
              }
            ]
          },
          "docs": "Deletes a fee. Once deleted, a fee cannot be accessed."
        }
      ]
    }
  ],
  "bundled": true
}