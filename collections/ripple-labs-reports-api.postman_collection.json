        {
          "id": "d35d5ebf-66c4-4685-824a-07099b8bb708",
          "name": "Create report",
          "request": {
            "name": "Create report",
            "description": {
              "content": "Request the generation of a custom report based on the specified parameters.\n\n**Report duration**\n\nReports can contain up to 90 days of transactions from the previous 9 months.\n\n* Minimum report duration is 1 day.\n* Maximum report duration is 90 days.\n\n#### Report retention\n\nReports are retained for 6 months after the `endDate` specified in your request.  After this period, the report is purged and will no longer be accessible.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportName\": \"<string>\",\n  \"reportType\": \"<string>\",\n  \"reportFormat\": \"<string>\",\n  \"startDate\": \"<dateTime>\",\n  \"endDate\": \"<dateTime>\"\n}",
