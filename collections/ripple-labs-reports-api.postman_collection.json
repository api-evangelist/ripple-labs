      "id": "2802aa9c-68cf-4a4d-98ce-60d8eb18c6e2",
      "name": "Reports",
      "description": {
        "content": "The Report Service API provides `PAYMENT_OPS`, `RECON`, and `FAILURE_CONVERSION_SSA` reports in either CSV or JSON format.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "01d5256b-ab90-42ef-811f-262e9be3d8a8",
          "name": "List reports",
          "request": {
            "name": "List reports",
            "description": {
              "content": "Returns an array of reports available for download. Each array element represents an available report, and contains the `reportId`, `reportType`, and `reportFormat` fields associated with that report.\n\nTo get the download link for a specific report, store the `reportId` for the report you want, and use it with the [Get a report](/products/payments-odl/api-docs/report_service/reference/openapi/reports/getreport) operation.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "created-by",
                  "value": "<string>"
                }
              ],
              "variable": []
