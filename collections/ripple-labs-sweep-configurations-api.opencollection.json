{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses Sweep Configurations API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sweep Configurations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Trigger a sweep configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/v2/workflows/sweep/:id/trigger",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the sweep configuration"
              }
            ]
          },
          "docs": "Manually trigger a single sweep configuration based on its ID"
        }
      ]
    }
  ],
  "bundled": true
}