{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses API Credentials API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Client credentials exchange",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/v2/credentials/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "OAuth client credentials exchange for access token"
        }
      ]
    }
  ],
  "bundled": true
}