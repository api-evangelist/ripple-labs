{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses Authentication API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/v2/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "audience",
                  "value": ""
                }
              ]
            }
          },
          "docs": "OAuth 2.0 Client Credentials grant. Returns a Bearer token valid for 1 hour.\nCredentials may be passed in the request body or via HTTP Basic Auth header.\n"
        }
      ]
    }
  ],
  "bundled": true
}