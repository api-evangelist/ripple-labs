{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses Wallet Tags API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Wallet Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all wallet tags in vault",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/v2/vaults/:vaultId/wallets/tags",
            "params": [
              {
                "name": "vaultId",
                "value": "",
                "type": "path",
                "description": "The vault ID"
              }
            ]
          },
          "docs": "List all tags from all wallets in the vault"
        },
        {
          "info": {
            "name": "List wallet tags for the wallet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/v2/vaults/:vaultId/wallets/:walletId/tags",
            "params": [
              {
                "name": "vaultId",
                "value": "",
                "type": "path",
                "description": "The vault ID"
              },
              {
                "name": "walletId",
                "value": "",
                "type": "path",
                "description": "The wallet ID"
              }
            ]
          },
          "docs": "List all wallet tags for the wallet"
        },
        {
          "info": {
            "name": "Add a new wallet tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/v2/vaults/:vaultId/wallets/:walletId/tags",
            "params": [
              {
                "name": "vaultId",
                "value": "",
                "type": "path",
                "description": "The vault ID"
              },
              {
                "name": "walletId",
                "value": "",
                "type": "path",
                "description": "The wallet ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new wallet tag to a wallet"
        },
        {
          "info": {
            "name": "Delete a wallet tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sandbox.palisade.co/v2/vaults/:vaultId/wallets/:walletId/tags",
            "params": [
              {
                "name": "vaultId",
                "value": "",
                "type": "path",
                "description": "The vault ID"
              },
              {
                "name": "walletId",
                "value": "",
                "type": "path",
                "description": "The wallet ID"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query",
                "description": "The tag"
              }
            ]
          },
          "docs": "Delete a wallet tag from a wallet"
        }
      ]
    }
  ],
  "bundled": true
}