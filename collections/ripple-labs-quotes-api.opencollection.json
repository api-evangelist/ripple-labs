{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses Quotes API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Quotes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Accept quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/payments/accept",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Accepts a quote ID to start the payment process."
        },
        {
          "info": {
            "name": "Get quotes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/quotes",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number for [paginated results](/products/payments-odl/api-docs/ripplenet/best-practices/pagination/). The value is zero-based, where `0` represents the first page.<br/>\nSet it to `0` to get the first page of results.\n"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of objects to return per page."
              }
            ]
          },
          "docs": "Gets a list of quotes."
        },
        {
          "info": {
            "name": "Get quote by quote ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/quotes/:quote_id",
            "params": [
              {
                "name": "quote_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the quote you want to retrieve."
              }
            ]
          },
          "docs": "Gets a quote by ID."
        },
        {
          "info": {
            "name": "Create quote collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/quote_collections",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a collection of quotes for a proposed payment."
        },
        {
          "info": {
            "name": "Get quote collection by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/quote_collections/:quote_collection_id",
            "params": [
              {
                "name": "quote_collection_id",
                "value": "",
                "type": "path",
                "description": "The ID of the quote collection you want returned."
              }
            ]
          },
          "docs": "Gets a quote collection that was created for a proposed payment."
        }
      ]
    }
  ],
  "bundled": true
}