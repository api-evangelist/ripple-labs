{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses Quote expiration API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Quote expiration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List quote expiries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/config/payments/quote_expiries",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based index of the page number of results."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of payments returned per page."
              }
            ]
          },
          "docs": "Returns all configured quote expiries."
        },
        {
          "info": {
            "name": "Create quote expiry",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.palisade.co/config/payments/quote_expiries",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a quote expiration window, or time to live (ttl), in seconds."
        },
        {
          "info": {
            "name": "Get quote expiry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/config/payments/quote_expiries/:quote_expiry_id",
            "params": [
              {
                "name": "quote_expiry_id",
                "value": "",
                "type": "path",
                "description": "The ID of the quote expiry you want returned."
              }
            ]
          },
          "docs": "Gets the time to live (ttl) of a quote expiry in seconds."
        },
        {
          "info": {
            "name": "Update quote expiry",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sandbox.palisade.co/config/payments/quote_expiries/:quote_expiry_id",
            "params": [
              {
                "name": "quote_expiry_id",
                "value": "",
                "type": "path",
                "description": "Provide the `quote_expiry_id` of the quote expiry you want to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the time to live (ttl) of a quote expiry in seconds."
        }
      ]
    }
  ],
  "bundled": true
}