            "name": "Obtain an access token",
            "description": {
              "content": "OAuth 2.0 Client Credentials grant. Returns a Bearer token valid for 1 hour.\nCredentials may be passed in the request body or via HTTP Basic Auth header.\n",
              "type": "text/plain"
            },
