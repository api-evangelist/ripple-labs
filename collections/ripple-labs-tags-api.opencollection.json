{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palisade Addresses Tags API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all tags for the organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.palisade.co/v2/tags"
          },
          "docs": "List all wallet and vault tags for the organization"
        }
      ]
    }
  ],
  "bundled": true
}